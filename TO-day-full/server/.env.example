# Salin file ini menjadi .env dan sesuaikan nilainya.

PORT=4000
NODE_ENV=development

# Ganti dengan string acak panjang saat produksi.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-rahasia-yang-kuat

# Connection string PostgreSQL (Supabase / Railway).
# Format: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# URL frontend (Vercel). Dipakai untuk CORS dan redirect setelah pembayaran.
# Kosongkan saat development lokal.
FRONTEND_URL=

# Jangan buat akun demo (johndoe@gmail.com) saat seed. Otomatis aktif saat
# NODE_ENV=production.
SKIP_DEMO_USER=false

# Otomatis menjalankan schema.sql saat server start (default: aktif saat
# NODE_ENV=production). Set true untuk development.
RUN_MIGRATIONS=false
# Isi soal/tryout saat server start. Idempotent; bisa dimatikan lagi setelah
# deploy pertama.
RUN_SEED=false

# --- Pembayaran manual (QRIS via WhatsApp) ---
# Aktifkan jika pembeli membayar QRIS lalu verifikasi manual lewat WhatsApp.
MANUAL_PAYMENT_ENABLED=false
# Nomor WhatsApp admin, format internasional tanpa tanda + (mis. 6281234567890).
WHATSAPP_NUMBER=
# Batas waktu order pending sebelum dianggap kedaluwarsa.
MANUAL_HOLD_HOURS=24
# Token rahasia untuk halaman /admin. Generate dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JANGAN pernah ditaruh di env frontend.
ADMIN_TOKEN=

# --- Midtrans ---
# Ambil dari dashboard Midtrans (Settings -> Access Keys).
# Production: Mid-server-... / Mid-client-...
# Sandbox:    SB-Mid-server-... / SB-Mid-client-...
# JANGAN pernah menaruh MIDTRANS_SERVER_KEY di frontend.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
