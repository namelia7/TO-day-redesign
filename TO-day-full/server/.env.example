# Salin file ini menjadi .env dan sesuaikan nilainya.

PORT=4000

# Ganti dengan string acak panjang saat produksi.
JWT_SECRET=ganti-dengan-rahasia-yang-kuat

# Lokasi file database SQLite (opsional, default: server/data/to-day.sqlite3)
# DB_PATH=./data/to-day.sqlite3

# --- Payment gateway (opsional, lihat src/routes/payments.js) ---
# Isi jika sudah mengaktifkan integrasi Midtrans/Xendit/dll.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# XENDIT_SECRET_KEY=
