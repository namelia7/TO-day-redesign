# Salin file ini menjadi .env jika backend tidak berjalan di localhost:4000.
VITE_API_URL=http://localhost:4000/api

# Client key Midtrans (aman dipublikasikan). Untuk sandbox gunakan SB-Mid-client-...
# Snap.js dimuat dinamis berdasarkan dua variabel di bawah.
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# true untuk production (app.midtrans.com), false untuk sandbox (app.sandbox.midtrans.com)
VITE_MIDTRANS_IS_PRODUCTION=false
